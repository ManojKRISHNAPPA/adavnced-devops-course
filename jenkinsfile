pipeline{
    agent any

    environment{
        IMAGE_NAME = "manojkrishnapp/chatbot:${GIT_COMMIT}"
    }


    stages{
        stage('gitcheckout'){
            steps{
                    git branch:'DEV', url: 'https://github.com/ManojKRISHNAPPA/adavnced-devops-course.git'
            }
            
        }

        stage('docker build'){
            steps{
                sh '''
                    printenv
                    docker build -t ${IMAGE_NAME} .
                '''
            }
        }

        // stage('Building container'){
        //     steps{
        //         sh '''
        //         docker stop ${IMAGE_NAME}
        //         docker rm ${IMAGE_NAME}
        //         docker run -it -d --name c1 -p 9000:8501 ${IMAGE_NAME}
        //         '''
        //     }
        // }


        stage('Login to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'docker-hub-cred',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    sh "echo $DOCKER_PASSWORD | docker login -u $DOCKER_USERNAME --password-stdin"
                }
            }
        }
        stage('uploading docker image to dockerhub'){
            steps{
                sh '''
                    docker push ${IMAGE_NAME}
                '''
            }
        }
    }
}