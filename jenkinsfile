pipeline{
    agent any

    stages{
        stage('gitcheckout'){
            steps{
                    git branch:'DEV' url: 'https://github.com/ManojKRISHNAPPA/adavnced-devops-course.git'
            }
            
        }

        stage('docker build'){
            steps{
                sh '''
                    docker build -t chatbot:1 .
                '''
            }
        }

        stage('Building container'){
            steps{
                sh '''
                docker run -it -d --name c1 -p 9000:8501 chatbot:1
                '''
            }
        }
    }
}